{{!-- Usage: {{> "adsense" slot="<ad slot ID>"}} --}}
{{^if @member.paid}}
    <div class="adsense">
        <ins class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-9097562495524795"
            data-ad-slot="{{slot}}"
            data-ad-format="horizontal"
            data-full-width-responsive="true">
        </ins>
        <script>
            (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
    </div>
{{/if}}
